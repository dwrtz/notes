{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "linked-notes",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-16",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "linked-notes",
      // Replace with your D1 id before a production deploy. Local `wrangler dev` does not need the real id.
      "database_id": "<YOUR_D1_DATABASE_ID>",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "linked-notes-attachments" }],
  // ALLOWED_EMAILS: comma-separated allowlist for sign-up, sign-in and sessions.
  // Empty (the default) means no extra restriction. Example: "you@example.com".
  "vars": { "NOW": "", "TEST_CLOCK": "0", "ALLOW_SIGNUP": "1", "ALLOWED_EMAILS": "" },
  "observability": { "enabled": true, "traces": { "enabled": true } }
}
